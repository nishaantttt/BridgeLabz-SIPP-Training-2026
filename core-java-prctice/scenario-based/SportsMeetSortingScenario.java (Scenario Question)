import java.util.Arrays;

public class SportsMeetSortingScenario {

    static int bubbleSort(int[] arr) {

        int swaps = 0;

        for (int i = 0; i < arr.length - 1; i++) {

            boolean swapped = false;

            for (int j = 0; j < arr.length - i - 1; j++) {

                if (arr[j] > arr[j + 1]) {

                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;

                    swaps++;
                    swapped = true;
                }
            }

            if (!swapped) {
                System.out.println("Already Sorted (Best Case)");
                break;
            }
        }

        return swaps;
    }

    static void insertionSort(int[] arr) {

        for (int i = 1; i < arr.length; i++) {

            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {

                arr[j + 1] = arr[j];
                j--;
            }

            arr[j + 1] = key;
        }
    }

    static void traceBubbleSort(int[] arr) {

        System.out.println("\nPass-wise Bubble Sort:");

        for (int i = 0; i < arr.length - 1; i++) {

            for (int j = 0; j < arr.length - i - 1; j++) {

                if (arr[j] > arr[j + 1]) {

                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }

            System.out.println("Pass " + (i + 1) + " : " + Arrays.toString(arr));
        }
    }

    public static void main(String[] args) {

        int[] scores = {55,72,91,68,84,99,60};

        int[] bubble = scores.clone();
        int[] insertion = scores.clone();

        int swaps = bubbleSort(bubble);

        insertionSort(insertion);

        System.out.println("Bubble Sort : " + Arrays.toString(bubble));
        System.out.println("Insertion Sort : " + Arrays.toString(insertion));
        System.out.println("Total Swaps : " + swaps);

        System.out.println("\nTop 3 Medalists:");
        for (int i = bubble.length - 1; i >= bubble.length - 3; i--) {
            System.out.println(bubble[i]);
        }

        int[] trace = {64,25,12,22,11};
        traceBubbleSort(trace);
    }
}